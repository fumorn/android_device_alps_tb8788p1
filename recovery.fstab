# TWRP recovery.fstab for tb8788p1_64_wifi (MT6771)
# Based on the stock recovery.fstab; /data is inlinecrypt-encrypted and
# NOT decryptable in phase 1 (left mountable-but-will-fail is intentional:
# TWRP will just report it cannot mount data).

# Logical partitions (dm-linear via super)
/system         /system         ext4    ro,barrier=1            wait,slotselect,logical,first_stage_mount
/vendor         /vendor         ext4    ro,barrier=1            wait,slotselect,logical,first_stage_mount
/product        /product        ext4    ro,barrier=1            wait,slotselect,logical,first_stage_mount

# Data (inlinecrypt - cannot decrypt in phase 1)
/data           /data           ext4    noatime,nosuid,nodev    wait,check,formattable,fileencryption=aes-256-xts

# Metadata (key storage - readable)
/metadata       /metadata       ext4    noatime,nosuid,nodev    wait,check,formattable
/dev/block/platform/bootdevice/by-name/md_udc /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable

# Boot-critical raw partitions (flashable in TWRP)
/dev/block/platform/bootdevice/by-name/boot     /boot       emmc defaults defaults,slotselect
/dev/block/platform/bootdevice/by-name/dtbo     /dtbo       emmc defaults defaults,slotselect
/dev/block/platform/bootdevice/by-name/logo     /logo       emmc defaults defaults
/dev/block/platform/bootdevice/by-name/lk       /lk         emmc defaults defaults
/dev/block/platform/bootdevice/by-name/lk2      /lk2        emmc defaults defaults
/dev/block/platform/bootdevice/by-name/vbmeta   /vbmeta     emmc defaults defaults,slotselect
/dev/block/platform/bootdevice/by-name/vbmeta_system /vbmeta_system emmc defaults defaults,slotselect
/dev/block/platform/bootdevice/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults defaults,slotselect
/dev/block/platform/bootdevice/by-name/para     /misc       emmc defaults defaults
/dev/block/platform/bootdevice/by-name/expdb    /expdb      emmc defaults defaults
/dev/block/platform/bootdevice/by-name/tee1     /tee1       emmc defaults defaults
/dev/block/platform/bootdevice/by-name/tee2     /tee2       emmc defaults defaults
/dev/block/platform/bootdevice/by-name/frp      /frp        emmc defaults defaults
/dev/block/platform/bootdevice/by-name/nvdata   /nvdata     emmc defaults defaults
/dev/block/platform/bootdevice/by-name/protect1 /protect1   emmc defaults defaults
/dev/block/platform/bootdevice/by-name/protect2 /protect2   emmc defaults defaults
/dev/block/platform/bootdevice/by-name/proinfo  /proinfo    emmc defaults defaults
/dev/block/platform/bootdevice/by-name/nvcfg    /nvcfg      emmc defaults defaults

# Removable storage
/devices/platform/externdevice* auto    auto    defaults    voldmanaged=sdcard1:auto
/devices/platform/usb3_xhci*    auto    vfat    defaults    voldmanaged=usbotg:auto
